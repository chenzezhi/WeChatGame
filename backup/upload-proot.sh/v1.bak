#!/usr/bin/env bash
#
# upload-proot.sh —— 在 proot 的 Ubuntu（glibc）里上传微信小游戏
#
# 为什么必须这样：
#   miniprogram-ci 编译时会 fork 一个 summer-compiler 子进程（日志里的
#   "forkProcess start"），子进程通过 IPC 回传结果。Android(bionic) 上这个
#   子进程没法正常回话，父进程就一直死等——表现就是「forkProcess start 之后
#   再无任何输出」。execPath 补丁只能让子进程正确启动，解决不了这层通信差异。
#   换到 glibc 的 Ubuntu 里跑，行为与桌面 Linux 一致，不再卡死。
#
# 用法：
#   bash upload-proot.sh --setup     # 首次：装容器 + node + miniprogram-ci（慢一次）
#   bash upload-proot.sh             # 以后每次上传
#   bash upload-proot.sh -v 1.0.2 -d "修复登录"
#   WX_TIMEOUT_SEC=1200 bash upload-proot.sh
#   DISTRO=debian bash upload-proot.sh
#
# 前置（若还没装）：
#   pkg install -y proot-distro
#   proot-distro install ubuntu
#
set -u

DISTRO="${DISTRO:-ubuntu}"
SRC="$(cd "$(dirname "$0")" && pwd)"
HOME_DIR="${HOME:-/data/data/com.termux/files/home}"
DEST="${WX_PROOT_PROJECT:-$HOME_DIR/wx-proot/WeChatGame}"
TIMEOUT_SEC="${WX_TIMEOUT_SEC:-900}"

WX_VERSION="${WX_VERSION:-}"
WX_DESC="${WX_DESC:-}"
WX_ROBOT="${WX_ROBOT:-}"

while [ $# -gt 0 ]; do
  case "$1" in
    -v|--version) WX_VERSION="${2:-}"; shift $(( $# > 1 ? 2 : 1 )) ;;
    -d|--desc)    WX_DESC="${2:-}";    shift $(( $# > 1 ? 2 : 1 )) ;;
    -r|--robot)   WX_ROBOT="${2:-}";   shift $(( $# > 1 ? 2 : 1 )) ;;
    --setup)      DO_SETUP=1; shift ;;
    -h|--help)    sed -n '2,28p' "$0" | sed 's/^#//'; exit 0 ;;
    *)            echo "[警告] 忽略未知参数：$1" >&2; shift ;;
  esac
done
DO_SETUP="${DO_SETUP:-0}"

die()  { echo "[错误] $*" >&2; exit 1; }
info() { echo "  $*"; }

# ================================================================ 环境检查
command -v proot-distro >/dev/null 2>&1 \
  || die "未安装 proot-distro。请先执行：\n       pkg install -y proot-distro\n       proot-distro install $DISTRO"

if ! proot-distro list 2>/dev/null | grep -qw "$DISTRO"; then
  die "未安装发行版 $DISTRO。请先执行：\n       proot-distro install $DISTRO\n     然后运行： bash upload-proot.sh --setup"
fi

# ================================================================ 首次安装
if [ "$DO_SETUP" = "1" ]; then
  echo "==> 在 $DISTRO 中安装 node / npm / miniprogram-ci（首次较慢，请耐心等待）"
  proot-distro login "$DISTRO" --termux-home -- bash -lc '
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y nodejs npm ca-certificates
    npm i -g miniprogram-ci
    echo "----- 容器内环境 -----"
    node -v
    npm -v
    npm root -g
  ' || die "容器内安装失败。若是网络问题，先确认容器里能联网：\n       proot-distro login $DISTRO\n       # 容器内执行： apt-get update"
  echo ""
  echo "==> 安装完成。以后直接运行： bash upload-proot.sh"
  exit 0
fi

# ================================================================ 项目校验
for f in game.js game.json project.config.json upload.js node-android-fix.js; do
  [ -f "$SRC/$f" ] || die "缺少必需文件：$f（目录：$SRC）"
done

# ================================================================ appid / 私钥
APPID="${WX_APPID:-}"
if [ -z "$APPID" ]; then
  APPID="$(sed -n 's/.*"appid"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
          "$SRC/project.config.json" 2>/dev/null | head -n1)"
fi
[ -n "$APPID" ] || die "project.config.json 里没有 appid"

KEY="${WX_KEY_PATH:-}"
if [ -z "$KEY" ]; then
  [ -f "$SRC/private.$APPID.key" ] && KEY="$SRC/private.$APPID.key"
  if [ -z "$KEY" ]; then
    for k in "$SRC"/private.*.key; do [ -f "$k" ] && { KEY="$k"; break; }; done
  fi
fi
[ -n "$KEY" ] && [ -f "$KEY" ] || die "找不到私钥。请放到项目根目录并命名为 private.$APPID.key"

# ================================================================ 复制到真实文件系统
# /storage/emulated/0 是 FUSE，Node 在上面同步读写会挂死；
# 而且 proot 只把 Termux 的 $HOME 映射成容器的 /root，
# 项目若在 /storage 下，容器里根本看不到，必须先复制进 $HOME。
EXCLUDE="upload.js upload.sh upload-auto.sh upload-proot.sh backup.sh node-android-fix.js forktest.js forkchild.js diagnose.sh nettest.sh node_modules backup .git .wx-tmp"

is_excluded() {
  local name="$1" e
  for e in $EXCLUDE; do
    [ "$name" = "$e" ] && return 0
  done
  case "$name" in README*|.gitignore|*.key) return 0 ;; esac
  return 1
}

echo "源目录    : $SRC"
echo "上传目录  : $DEST"
echo ""
if [ "$SRC" = "$DEST" ]; then
  info "已在真实文件系统，跳过复制"
else
  echo "正在复制到真实文件系统（绕开 /storage FUSE 卡死）..."
  mkdir -p "$DEST" || die "无法创建 $DEST"
  cd "$SRC" || die "无法进入 $SRC"
  shopt -s nullglob
  n=0
  for item in *; do
    is_excluded "$item" && continue
    rm -rf "$DEST/$item"
    cp -rf "$item" "$DEST/$item" || die "复制失败：$item"
    info "+ $item"
    n=$((n + 1))
  done
  shopt -u nullglob
  [ "$n" -gt 0 ] || die "源目录没有可复制的文件"
fi

# 运行脚本和补丁也要进容器目录（upload.js 第一行就 require 它）
cp -f "$SRC/upload.js"           "$DEST/upload.js"           || die "复制 upload.js 失败"
cp -f "$SRC/node-android-fix.js" "$DEST/node-android-fix.js" || die "复制 node-android-fix.js 失败"
cp -f "$KEY" "$DEST/$(basename "$KEY")" || die "复制私钥失败"

for f in game.js game.json project.config.json upload.js node-android-fix.js; do
  [ -f "$DEST/$f" ] || die "上传目录缺少：$f"
done
KEY_IN_NAME="$(basename "$KEY")"
[ -f "$DEST/$KEY_IN_NAME" ] || die "上传目录缺少私钥：$KEY_IN_NAME"

# ================================================================ 容器内路径
case "$DEST" in
  "$HOME_DIR"*) INNER="/root${DEST#$HOME_DIR}" ;;
  *) die "项目不在 Termux 家目录下，proot 容器里看不到：$DEST" ;;
esac

# ================================================================ 组装命令
ENVV=""
[ -n "$WX_VERSION" ] && ENVV="$ENVV WX_VERSION='$WX_VERSION'"
[ -n "$WX_DESC" ]    && ENVV="$ENVV WX_DESC='$WX_DESC'"
[ -n "$WX_ROBOT" ]   && ENVV="$ENVV WX_ROBOT='$WX_ROBOT'"

echo "容器目录  : $INNER"
echo "AppID     : $APPID"
echo "私钥      : $KEY_IN_NAME"
echo "版本号    : ${WX_VERSION:-1.0.0（默认）}"
echo "上限      : ${TIMEOUT_SEC}s"
echo ""
echo "开始上传（容器内运行，绕开 Android fork 死锁）..."
echo ""

# 关键：env -u 清掉 NODE_OPTIONS 和代理变量。
# --dns-result-order 这类参数在旧 node 里会让子进程直接起不来，
# 表现就是 forkProcess start 之后父进程死等。
# timeout 保证无论怎样都不会无限卡住。
INNER_CMD="cd '$INNER' && exec env -u NODE_OPTIONS -u http_proxy -u https_proxy -u all_proxy \
-u HTTP_PROXY -u HTTPS_PROXY \
WX_PROJECT_PATH='$INNER' WX_APPID='$APPID' WX_KEY_PATH='$INNER/$KEY_IN_NAME'$ENVV \
        timeout --kill-after=10 $TIMEOUT_SEC node upload.js"

proot-distro login "$DISTRO" --termux-home -- bash -lc "$INNER_CMD"
RC=$?

echo ""
echo "============================================================"
if [ "$RC" = "0" ]; then
  echo "完成：版本 ${WX_VERSION:-1.0.0}（AppID $APPID）"
  echo "查看：用 AppID 为 $APPID 的小游戏账号登录 https://mp.weixin.qq.com"
  echo "      → 管理 → 版本管理 → 开发版本"
  echo ""
  echo "看不到时检查："
  echo "  1. 登录的是不是同一个 AppID（小游戏与小程序后台分开）"
  echo "  2. 同一 机器人+版本号 会覆盖旧开发版本，不是新增"
  echo "  3. 换版本号验证： bash upload-proot.sh -v 9.9.9"
elif [ "$RC" = "124" ]; then
  echo "超时：${TIMEOUT_SEC}s 内没有完成，已强制终止。"
  echo "如果确实很慢，可以放大上限： WX_TIMEOUT_SEC=1800 bash upload-proot.sh"
else
  echo "上传失败（退出码 $RC）。"
  echo "排查："
  echo "  · 容器里没装 miniprogram-ci → bash upload-proot.sh --setup"
  echo "  · 容器不能联网 → proot-distro login $DISTRO 后 apt-get update 试试"
  echo "  · 80082 / 无权限 / invalid ip → 私钥与 AppID 不匹配或已失效"
fi
echo "============================================================"

exit "$RC"
