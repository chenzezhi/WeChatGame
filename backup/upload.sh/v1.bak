#!/usr/bin/env bash
#
# upload-auto.sh —— 一键把「当前项目」上传到微信小游戏后台
#
# 它会自动完成这些事：
#   1. 定位项目目录（脚本所在目录），并校验 game.js / game.json / project.config.json
#   2. 自动读取 project.config.json 里的 appid
#   3. 自动查找上传私钥 private.*.key
#   4. 清除 http(s)_proxy 等代理变量（代理是「编译完成后卡住」的常见原因）
#   5. 可选联网预检（能连上 servicewechat.com 才继续）
#   6. 没给版本号时自动生成 1.0.MMDDHHMM
#   7. 自动选择上传方式：proot Ubuntu（最稳）→ Termux 原生 → 直接 node
#      并且：原生方式失败时，会自动改用 proot 再试一次
#
set -u

# ---------------------------------------------------------------- 帮助
usage() {
  cat <<'EOF'
用法： bash upload-auto.sh [选项]

选项：
  -v, --version <x.y.z>   上传版本号（默认自动生成 1.0.MMDDHHMM）
  -d, --desc <文字>       版本描述
  -r, --robot <编号>      使用的 CI 机器人编号（1-30）
  -m, --mode <方式>       auto | proot | native | node（默认 auto）
      --setup             首次准备 proot Ubuntu 上传环境
      --no-netcheck       跳过上传前的联网预检
  -h, --help              显示本帮助

示例：
  bash upload-auto.sh
  bash upload-auto.sh --version 1.0.2 --desc "修复登录"
  WX_MODE=proot bash upload-auto.sh
EOF
}

# ---------------------------------------------------------------- 解析参数
WX_VERSION="${WX_VERSION:-}"
WX_DESC="${WX_DESC:-}"
WX_ROBOT="${WX_ROBOT:-}"
WX_MODE="${WX_MODE:-auto}"
WX_SKIP_NETCHECK="${WX_SKIP_NETCHECK:-0}"
WX_NO_FALLBACK="${WX_NO_FALLBACK:-0}"
DO_SETUP=0

while [ $# -gt 0 ]; do
  case "$1" in
    -v|--version) WX_VERSION="${2:-}"; shift $(( $# > 1 ? 2 : 1 )) ;;
    -d|--desc|--description) WX_DESC="${2:-}"; shift $(( $# > 1 ? 2 : 1 )) ;;
    -r|--robot) WX_ROBOT="${2:-}"; shift $(( $# > 1 ? 2 : 1 )) ;;
    -m|--mode) WX_MODE="${2:-}"; shift $(( $# > 1 ? 2 : 1 )) ;;
    --setup) DO_SETUP=1; shift ;;
    --no-netcheck) WX_SKIP_NETCHECK=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "[错误] 未知参数：$1（用 -h 查看用法）" >&2; exit 2 ;;
  esac
done

# ---------------------------------------------------------------- 定位项目
PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$PROJECT_DIR" || { echo "[错误] 无法进入目录：$PROJECT_DIR" >&2; exit 1; }

for f in game.js game.json project.config.json; do
  if [ ! -f "$PROJECT_DIR/$f" ]; then
    echo "[错误] 这里不像微信小游戏项目，缺少：$f"
    echo "       目录：$PROJECT_DIR"
    exit 1
  fi
done

# ---------------------------------------------------------------- AppID
APPID="${WX_APPID:-}"
if [ -z "$APPID" ]; then
  CFG="$PROJECT_DIR/project.config.json"
  if command -v node >/dev/null 2>&1; then
    APPID="$(node -e 'const fs=require("fs");try{const c=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));process.stdout.write((c.appid||"").trim())}catch(e){}' "$CFG" 2>/dev/null)"
  fi
  if [ -z "$APPID" ]; then
    APPID="$(sed -n 's/.*"appid"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CFG" 2>/dev/null | head -1)"
  fi
fi

# ---------------------------------------------------------------- 上传私钥
KEY_PATH="${WX_KEY_PATH:-}"
if [ -z "$KEY_PATH" ]; then
  for k in "$PROJECT_DIR"/private.*.key "$PROJECT_DIR"/*.key; do
    if [ -f "$k" ]; then KEY_PATH="$k"; break; fi
  done
fi

# ---------------------------------------------------------------- 去掉代理 & 强制 DNS IPv4
unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ftp_proxy FTP_PROXY 2>/dev/null || true
export NODE_OPTIONS="--dns-result-order=ipv4first ${NODE_OPTIONS:-}"

# ---------------------------------------------------------------- 打印信息
echo "============================================================"
echo " 目录    : $PROJECT_DIR"
echo " AppID   : ${APPID:-<未在 project.config.json 中找到>}"
echo " 私钥    : ${KEY_PATH:-<未找到 *.key>}"

# 版本号：没填就自动生成
if [ -z "$WX_VERSION" ]; then
  WX_VERSION="1.0.$(date +%m%d%H%M)"
  echo " 版本号  : $WX_VERSION （自动生成）"
else
  echo " 版本号  : $WX_VERSION"
fi
[ -n "$WX_DESC" ] && echo " 描述    : $WX_DESC"
[ -n "$WX_ROBOT" ] && echo " 机器人  : $WX_ROBOT"
echo "============================================================"

if [ -z "$KEY_PATH" ]; then
  echo "[警告] 没有找到上传私钥（private.*.key）。"
  echo "       请把微信公众平台下载的密钥放到本目录，或用 WX_KEY_PATH 指定。"
fi

# ---------------------------------------------------------------- proot 检测
has_proot_ubuntu() {
  local d
  for d in \
    "${PREFIX:-/data/data/com.termux/files/usr}/var/lib/proot-distro/installed-rootfs/ubuntu" \
    "${HOME:-/root}/.local/share/proot-distro/installed-rootfs/ubuntu"; do
    [ -d "$d" ] && return 0
  done
  return 1
}

# ---------------------------------------------------------------- 联网预检
if [ "$WX_SKIP_NETCHECK" != "1" ] && command -v curl >/dev/null 2>&1; then
  echo "联网预检：servicewechat.com ..."
  CODE="$(curl -s -m 8 -o /dev/null -w '%{http_code}' https://servicewechat.com/ 2>/dev/null || true)"
  if [ -z "$CODE" ] || [ "$CODE" = "000" ]; then
    echo "[警告] 连不上微信服务器（可能是网络环境或代理）。"
    echo "       仍会继续上传；如果卡住，请先换网络，或直接跑："
    echo "         WX_MODE=proot bash upload-auto.sh"
  else
    echo "        OK（HTTP $CODE）"
  fi
  echo ""
fi

# ---------------------------------------------------------------- 选择方式
MODE="$WX_MODE"
if [ "$MODE" = "auto" ]; then
  if has_proot_ubuntu && [ -f "$PROJECT_DIR/upload-proot.sh" ]; then
    MODE="proot"
  elif [ -f "$PROJECT_DIR/upload.sh" ]; then
    MODE="native"
  else
    MODE="node"
  fi
fi

# ---------------------------------------------------------------- Termux 原生上传守护包装器
run_native_guarded() {
  local cmd="$1"
  local logfile
  logfile="$(mktemp)"

  # 在后台启动实际的上传脚本，并将其输出同时打印到控制台和临时日志
  eval "$cmd" 2>&1 | tee "$logfile" &
  local pid=$!

  local count=0
  local max_wait=60 # 最大等待 60 秒

  while kill -0 $pid 2>/dev/null; do
    sleep 2
    count=$((count + 2))

    # 1. 监测日志中是否已出现完成标志（game.js done / upload success）
    if grep -qE '("50000004".*"status":"done"|upload success|DONE)' "$logfile" 2>/dev/null; then
      echo ""
      echo "[自动解卡] 检测到 miniprogram-ci 编译上传已完成！"
      echo "[自动解卡] 正在强行终止 Termux 死锁的后台 Node 句柄..."
      sleep 1
      kill -9 $pid 2>/dev/null || true
      rm -f "$logfile"
      return 0
    fi

    # 2. 超时保护
    if [ $count -ge $max_wait ]; then
      echo ""
      echo "[自动解卡] 执行超过 $max_wait 秒未响应，强制结束挂起的进程。"
      kill -9 $pid 2>/dev/null || true
      # 如果日志里有 status done 说明成功，否则认为失败
      if grep -q '"status":"done"' "$logfile" 2>/dev/null; then
        rm -f "$logfile"
        return 0
      else
        rm -f "$logfile"
        return 1
      fi
    fi
  done

  wait $pid
  local ret=$?
  rm -f "$logfile"
  return $ret
}

run_upload() {
  local m="$1"
  case "$m" in
    proot)
      echo ">>> 使用 proot Ubuntu 上传（兼容性最好）"
      if [ "$DO_SETUP" = "1" ]; then
        bash "$PROJECT_DIR/upload-proot.sh" --setup
      else
        bash "$PROJECT_DIR/upload-proot.sh"
      fi
      ;;
    native)
      echo ">>> 使用 Termux 原生 Node 上传（含死锁自动解卡保护）"
      run_native_guarded "bash \"$PROJECT_DIR/upload.sh\""
      ;;
    node)
      echo ">>> 直接运行 node upload.js（含死锁自动解卡保护）"
      run_native_guarded "node \"$PROJECT_DIR/upload.js\""
      ;;
    *)
      echo "[错误] 未知上传方式：$m" >&2
      return 2
      ;;
  esac
}

# 透传参数给底层脚本 / upload.js
export WX_PROJECT_PATH="$PROJECT_DIR"
export WX_VERSION
export WX_DESC
export WX_ROBOT
if [ -n "$APPID" ]; then export WX_APPID="$APPID"; fi
if [ -n "$KEY_PATH" ]; then export WX_KEY_PATH="$KEY_PATH"; fi

echo ""
run_upload "$MODE"
STATUS=$?

# ---------------------------------------------------------------- 失败自动回退到 proot
if [ "$STATUS" -ne 0 ] && [ "$WX_NO_FALLBACK" != "1" ] \
   && [ "$MODE" != "proot" ] && has_proot_ubuntu \
   && [ -f "$PROJECT_DIR/upload-proot.sh" ]; then
  echo ""
  echo "============================================================"
  echo "[提示] 上面的方式失败了（未完成编译）。"
  echo "       自动改用 proot Ubuntu 再试一次..."
  echo "============================================================"
  echo ""
  run_upload proot
  STATUS=$?
fi

# ---------------------------------------------------------------- 结果
echo ""
echo "============================================================"
if [ "$STATUS" -eq 0 ]; then
  echo "完成：已提交版本 $WX_VERSION（AppID ${APPID:-未知}）"
  echo "到微信公众平台 -> 版本管理 即可看到本次上传。"
else
  echo "上传失败（退出码 $STATUS）。"
  echo "排查建议："
  echo "  1. 换网络（Wi-Fi / 移动数据），并确认没开代理/VPN"
  echo "  2. 首次使用 proot：bash upload-auto.sh --setup"
  echo "  3. 再试：WX_MODE=proot bash upload-auto.sh"
fi
echo "============================================================"

exit "$STATUS"
